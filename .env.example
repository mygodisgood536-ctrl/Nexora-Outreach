# ─────────────────────────────────────────────────────────────
# Nexora Outreach — environment configuration
# Copy to `.env` and fill in. NEVER commit the real `.env`.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=4317

# Public origin of this app (used to build OAuth redirect URIs)
PUBLIC_BASE_URL=http://localhost:4317

# ── Secrets ──────────────────────────────────────────────────
# 64 hex chars = 32 bytes. Encrypts email authorization tokens at
# rest with AES-256-GCM. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=

# Session lifetime in hours
SESSION_TTL_HOURS=72

# ── Production database (Neon PostgreSQL, managed by Vercel) ──
# When set, the app talks to PostgreSQL (the DSN comes from the
# Vercel project's environment variables). When blank it falls
# back to the zero-install SQLite file for development and tests.
# NEVER commit a real DSN.
DATABASE_URL=

# ── OpenCode (central AI provider/model runtime) ─────────────
# OpenCode is the AI provider/model middleware. The provider/model
# catalog is ALWAYS discovered from OpenCode at runtime — never a
# hard-coded Nexora list.
#
# PRODUCTION (Vercel): OpenCode Cloud.
#   OPENCODE_API_KEY = your OpenCode Cloud service-account key
#   (starts with "oc_sk_"). It is a SERVER-SIDE SECRET: never commit
#   it, never expose it to the browser, never log it. Set it in the
#   Vercel project's Production environment variables.
# Nexora discovers models from the workspace config API and runs each
# prompt on the matching gateway. These endpoints have sane defaults.
OPENCODE_API_KEY=
OPENCODE_CLOUD_URL=https://opencode.ai
OPENCODE_CONSOLE_URL=https://console.opencode.ai

# Path to the local OpenCode binary. Leave blank to auto-detect.
OPENCODE_BIN=
# Initial default model (provider/model). Validated against the live
# catalog; it is only a preference, not a hard-coded catalog.
OPENCODE_DEFAULT_MODEL=opencode/space-bunny-free
# Hard ceiling (ms) for a single AI execution, and max output tokens.
OPENCODE_TIMEOUT_MS=180000
OPENCODE_MAX_TOKENS=4096

# ALTERNATIVE: a self-hosted `opencode serve`. When OPENCODE_BASE_URL is
# set (and no oc_sk_ key is present) Nexora uses the HTTP transport:
#   GET  /global/health      GET /config/providers
#   POST /session            POST /session/:id/message
OPENCODE_BASE_URL=
OPENCODE_SERVER_USERNAME=opencode

# ── Email: Google / Gmail ────────────────────────────────────
# Nexora never asks for the user's mailbox password.
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Redirect URI must equal: ${PUBLIC_BASE_URL}/api/email/google/callback

# ── Email: Microsoft / Outlook ───────────────────────────────
# https://portal.azure.com → App registrations
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
# Redirect URI must equal: ${PUBLIC_BASE_URL}/api/email/microsoft/callback

# ── Discovery ────────────────────────────────────────────────
# OpenStreetMap Overpass (keyless, permitted use). Real source.
OVERPASS_URL=https://overpass-api.de/api/interpreter
# Google Places (Text Search) — optional, needs a key
GOOGLE_PLACES_API_KEY=

# ── Research politeness ──────────────────────────────────────
# Milliseconds between outbound requests to any single host.
RESEARCH_FETCH_DELAY_MS=1500
RESEARCH_TIMEOUT_MS=20000
RESEARCH_MAX_BYTES=2000000
# Respect robots.txt Disallow rules (spec §24)
RESPECT_ROBOTS_TXT=true

# ── Automation safety limits (global ceilings) ───────────────
GLOBAL_MAX_SENDS_PER_DAY=50
DEFAULT_MAX_FOLLOW_UPS=3
DEFAULT_FOLLOW_UP_DELAY_DAYS=2

# ── Provider bounce/complaint webhooks (§17) ─────────────────
# When set, POST /api/email/events accepts a matching
# X-Nexora-Webhook-Secret header. Blank = session-only.
WEBHOOK_SECRET=

# ── Serverless automation driver (§26) ───────────────────────
# On Vercel there is no long-running scheduler/worker loop, so Vercel
# Cron calls GET/POST /api/cron/tick with "Authorization: Bearer $CRON_SECRET".
# Also verifies ownership of the cron endpoint. Blank disables the tick.
CRON_SECRET=
CRON_MAX_JOBS=50